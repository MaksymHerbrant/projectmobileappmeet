# Flutter/Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.metadata
build/
# pubspec.lock навмисно НЕ ігнорується: це застосунок, а не бібліотека.
# Файл фіксує точні версії залежностей, тож збірка на іншій машині й у CI
# дає той самий результат. Саме розходження версій ламало збірку під iOS.

# IDE
.idea/
.vscode/
*.iml

# Platform specific
android/.gradle/
android/app/release/
android/app/profile/
android/app/debug/
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/
macos/Flutter/ephemeral/
macos/Pods/
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# Credentials / secrets
.env
.env.*
**/google-services.json
**/GoogleService-Info.plist
*.keystore
*.keystore.jks
*.jks

# Firebase Service Account key (не комітити в репозиторій)
mateme-e68a6-8287af5ff2f6.json
**/firebase*service*account*.json

# Misc
coverage/
.DS_Store
*.log
*.lock
# ...окрім лок-файлів залежностей: це застосунок, і точні версії мають
# лежати в репозиторії, щоб збірка в Юлі та в CI була така сама.
!pubspec.lock
!ios/Podfile.lock
!macos/Podfile.lock
# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

